# 백엔드 API를 호출하지 않고 로컬 목 응답을 사용합니다.
# 백엔드 없이 프론트엔드를 개발할 때 true로 설정하세요.
NEXT_PUBLIC_USE_MOCK=true

# 브라우저 요청에서 사용하는 공개 API base URL입니다.
# 비워 두면 /api/recommend처럼 같은 origin으로 요청합니다.
NEXT_PUBLIC_API_BASE_URL=

# 서버에서만 사용하는 API base URL입니다.
# 서버에서 요청할 때 NEXT_PUBLIC_API_BASE_URL보다 우선합니다.
API_BASE_URL=

# 공개 앱 base URL입니다. 코드의 기본값은 http://localhost:3000입니다.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
